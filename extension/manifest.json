{
  "manifest_version": 3,
  "name": "Concourse Capture",
  "version": "0.7.11",
  "description": "Review and save job applications in Concourse. Gmail outreach tracking is in progress.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://localhost:8787/*",
    "http://127.0.0.1:8787/*",
    "http://localhost:4000/*",
    "http://127.0.0.1:4000/*",
    "https://concourse.chiragb0707.workers.dev/*"
  ],
  "action": {
    "default_title": "Capture with Concourse",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "web_accessible_resources": [{ "resources": ["icons/brand-mark.svg"], "matches": ["http://*/*", "https://*/*"] }],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": [
        "https://mail.google.com/*",
        "http://localhost:8787/*",
        "http://127.0.0.1:8787/*",
        "https://concourse.chiragb0707.workers.dev/*"
      ],
      "js": ["page-capture.js", "job-capture.js"],
      "css": ["job-capture.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["gmail.js"],
      "css": ["gmail.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:8787/*",
        "http://127.0.0.1:8787/*",
        "https://concourse.chiragb0707.workers.dev/*"
      ],
      "js": ["workspace-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
